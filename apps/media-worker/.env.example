# Copy to .env for local runs. Never commit a real service_role key —
# this file only documents the shape of the values, it is not itself
# consumed automatically (pass real env vars via `docker run -e` or your
# shell, per the "no secrets in files" rule that applies to every other
# part of this repo).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

MEDIA_WORKER_ID=local-dev
MEDIA_WORKER_BUCKET=campaign-media
MEDIA_WORKER_POLL_INTERVAL_MS=5000
MEDIA_WORKER_EMPTY_QUEUE_BACKOFF_MS=5000
MEDIA_WORKER_JOB_TIMEOUT_MS=300000
MEDIA_WORKER_MAX_OUTPUT_BYTES=47185920
MEDIA_WORKER_HEALTH_PORT=8080
