{
  "name": "maxcar",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@maxcar/admin",
    "build": "npm run build --workspace=@maxcar/admin",
    "lint": "npm run lint --workspace=@maxcar/admin",
    "typecheck": "npm run typecheck --workspace=@maxcar/admin",
    "test": "npm run test --workspaces --if-present",
    "auth:diagnose": "node scripts/debug-auth.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:check": "node scripts/validate-migrations.mjs",
    "db:lint": "supabase db lint --local --level error --fail-on error",
    "db:test": "supabase test db --local supabase/tests",
    "db:types": "node scripts/generate-database-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.2",
    "supabase": "^2.110.0"
  },
  "engines": {
    "node": ">=22"
  }
}
